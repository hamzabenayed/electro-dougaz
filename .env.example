NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Local Docker default only. Use secret-managed credentials in production.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://electro:local-development-only@localhost:5432/electro_dougaz
DATABASE_POOL_MAX=10
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000
MIGRATIONS_DIR=../../apps/shared/migrations
LOG_LEVEL=info
DELIVERY_FEE_MILLIMES=8000

# Used only by `pnpm --filter @electro/api admin:create`; choose a unique 12+ character password locally.
ADMIN_EMAIL=admin@example.tn
ADMIN_DISPLAY_NAME=Administrateur Electro Dougaz
ADMIN_PASSWORD=replace-with-a-strong-local-password

# Keep real payment credentials outside source control.
PAYMENT_PROVIDER=stub
CLICKTOPAY_MERCHANT_ID=
CLICKTOPAY_SECRET=
CLICKTOPAY_BASE_URL=

MEDIA_DRIVER=local
MEDIA_ROOT=../../media-data
# Optional private/internal API address for Next.js server rendering (never include credentials).
# API_INTERNAL_BASE_URL=http://localhost:4000/api/v1

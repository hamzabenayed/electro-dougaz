{
  "name": "electro-dougaz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @electro/database migrate",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
